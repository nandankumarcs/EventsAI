{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Backend Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    },
    {
      "name": "Python: Backend Unittest Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    }
  ]
}
